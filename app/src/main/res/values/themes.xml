<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Over the lock screen: black from the first frame, and no sliding in as the phone wakes. -->
    <style name="Theme.Prism.LockScreen" parent="Theme.Prism">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <color name="splash_bg">#0B0B0B</color>
    <color name="ic_launcher_background">#0B0B0B</color>
</resources>
